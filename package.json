{
  "name": "investment-office",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x || 26.x",
    "npm": ">=10"
  },
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "predev": "npm run build --workspace @investment-office/shared",
    "predev:api": "npm run build --workspace @investment-office/shared",
    "predb:migrate": "npm run build --workspace @investment-office/shared",
    "dev": "npm run dev --workspace @investment-office/frontend --",
    "dev:api": "npm run dev --workspace @investment-office/backend",
    "db:migrate": "npm run dev:migrate --workspace @investment-office/backend",
    "pretypecheck": "npm run build --workspace @investment-office/shared",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^16.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
