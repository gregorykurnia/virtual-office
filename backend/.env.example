NODE_ENV=development
HOST=127.0.0.1
PORT=3001
FIREBASE_PROJECT_ID=your-firebase-project-id
OWNER_UID=your-firebase-auth-user-uid
# Optional comma-separated exact browser origins. Leave empty for same-origin only.
CORS_ORIGINS=http://localhost:5173
# Optional explicit proxy addresses/CIDRs. Leave empty unless the API is behind a trusted proxy.
TRUST_PROXY_CIDRS=
LOG_LEVEL=info
RATE_LIMIT_MAX=120
FIRESTORE_PROBE_DOCUMENT=system/health
# Firebase Admin uses Application Default Credentials or the platform identity.
# Do not put service-account JSON or private keys in this file.
# Emulator-only: set FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 and
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 when the Firebase emulators are running.
