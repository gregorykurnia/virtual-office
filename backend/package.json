{
  "name": "@investment-office/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env.local --import tsx/esm src/server.ts",
    "dev:migrate": "node --env-file-if-exists=.env.local --import tsx/esm src/migrate.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "node --import tsx/esm --test src/app.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@investment-office/shared": "^0.1.0",
    "fastify": "^5.12.5",
    "firebase-admin": "^13.10.0",
    "zod": "^4.6.5"
  }
}
